# Copy to .env.production (gitignored) before `npm run build` when deploying the frontend and backend
# as separate Azure resources - e.g. an Azure Static Web App calling an Azure App Service API.
# Leave this file's settings unset (no .env.production) if frontend and backend share one origin instead.

VITE_API_BASE_URL=https://your-api-app-name.azurewebsites.net
